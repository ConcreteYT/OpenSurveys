# Copy this file to .env and fill in real values.
#   Windows (PowerShell):  Copy-Item .env.example .env
#   macOS / Linux:         cp .env.example .env
# .env is gitignored — never commit real secrets.
# Restart `npm start` after changing this file (CRA reads env vars at startup).

# Same value as GOOGLE_CLIENT_ID in rtgpoll-backend/.env
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Web client
# Add authorized JavaScript origins (e.g. http://localhost:3000)
REACT_APP_GOOGLE_CLIENT_ID=

# Optional. Only needed for a production build that is NOT served by the Spring Boot
# backend (or when the API is on a different host). Leave empty for local `npm start`
# — the CRA proxy in package.json already forwards to http://localhost:8080.
# REACT_APP_API_URL=https://your-api.example.com
