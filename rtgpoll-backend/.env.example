# Copy this file to .env and fill in real values.
#   Windows (PowerShell):  Copy-Item .env.example .env
#   macOS / Linux:         cp .env.example .env
# .env is gitignored — never commit real secrets.

# MySQL connection
DB_URL=jdbc:mysql://localhost:3306/rtgpoll?useSSL=false
DB_USERNAME=
DB_PASSWORD=

# Long random string used to sign JWTs (changing it logs everyone out)
JWT_SECRET=

# Bootstrapped admin account (created/updated on backend startup)
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=

# Same value as REACT_APP_GOOGLE_CLIENT_ID in rtgpoll-frontend/.env
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Web client
GOOGLE_CLIENT_ID=

# SMTP for verification emails (account email/password change codes)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
